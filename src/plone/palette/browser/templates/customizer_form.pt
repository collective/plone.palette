<tal:macros xmlns="http://www.w3.org/1999/xhtml"
            xmlns:i18n="http://xml.zope.org/namespaces/i18n"
            xmlns:metal="http://xml.zope.org/namespaces/metal"
            xmlns:tal="http://xml.zope.org/namespaces/tal"
            i18n:domain="plone.palette"
>

  <!-- The customizer form, shared by the standalone @@palette-customizer view and
     the offcanvas the "Theming" toolbar entry opens.  `view` is whichever of the
     two renders it; both mix in _CustomizerMixin, so the expressions below
     resolve identically. -->
  <metal:form define-macro="palette-form">

    <div id="palette-customizer-content">

      <div id="form-feedback"></div>

      <form class="pat-autosubmit pat-inject"
            id="palette-customizer-form"
            method="POST"
            data-pat-autosubmit="delay: 800"
            data-pat-inject="target: #form-feedback"
            tal:attributes="
              action string:${context/absolute_url}/@@palette-save;
            "
      >

        <input name="_authenticator"
               type="hidden"
               tal:attributes="
                 value context/@@authenticator/token;
               "
        />

        <!-- Tab nav -->
        <ul class="nav nav-tabs mb-3"
            id="customizer-tabs"
            role="tablist"
        >
          <li class="nav-item"
              role="presentation"
          >
            <button class="nav-link active"
                    id="tab-colors-btn"
                    aria-controls="tab-colors"
                    aria-selected="true"
                    role="tab"
                    type="button"
                    data-bs-target="#tab-colors"
                    data-bs-toggle="tab"
            >
          Colors
            </button>
          </li>
          <li class="nav-item"
              role="presentation"
          >
            <button class="nav-link"
                    id="tab-typography-btn"
                    aria-controls="tab-typography"
                    aria-selected="false"
                    role="tab"
                    type="button"
                    data-bs-target="#tab-typography"
                    data-bs-toggle="tab"
            >
          Typography
            </button>
          </li>
          <li class="nav-item"
              role="presentation"
          >
            <button class="nav-link"
                    id="tab-borders-btn"
                    aria-controls="tab-borders"
                    aria-selected="false"
                    role="tab"
                    type="button"
                    data-bs-target="#tab-borders"
                    data-bs-toggle="tab"
            >
          Borders
            </button>
          </li>
          <li class="nav-item"
              role="presentation"
          >
            <button class="nav-link"
                    id="tab-navbar-footer-btn"
                    aria-controls="tab-navbar-footer"
                    aria-selected="false"
                    role="tab"
                    type="button"
                    data-bs-target="#tab-navbar-footer"
                    data-bs-toggle="tab"
            >
          Navbar &amp; Footer
            </button>
          </li>
          <li class="nav-item"
              role="presentation"
          >
            <button class="nav-link"
                    id="tab-properties-btn"
                    aria-controls="tab-properties"
                    aria-selected="false"
                    role="tab"
                    type="button"
                    data-bs-target="#tab-properties"
                    data-bs-toggle="tab"
            >
          Properties
            </button>
          </li>
          <li class="nav-item"
              role="presentation"
          >
            <button class="nav-link"
                    id="tab-css-btn"
                    aria-controls="tab-css"
                    aria-selected="false"
                    role="tab"
                    type="button"
                    data-bs-target="#tab-css"
                    data-bs-toggle="tab"
            >
          CSS
            </button>
          </li>
        </ul>

        <div class="tab-content"
             id="customizer-tab-content"
        >

          <!-- ── Colors ──────────────────────────────────────────────── -->
          <div class="tab-pane fade show active"
               id="tab-colors"
               aria-labelledby="tab-colors-btn"
               role="tabpanel"
          >

            <p class="text-muted small mb-2">Bootstrap theme colors</p>
            <div class="row row-cols-3 g-3 mb-4">
              <tal:colors tal:repeat="item python:[
              ('primary',   'Primary',   view.primary_color,   '--bs-primary'),
              ('secondary', 'Secondary', view.secondary_color, '--bs-secondary'),
              ('success',   'Success',   view.success_color,   '--bs-success'),
              ('danger',    'Danger',    view.danger_color,    '--bs-danger'),
              ('warning',   'Warning',   view.warning_color,   '--bs-warning'),
              ('info',      'Info',      view.info_color,      '--bs-info'),
            ]">
                <tal:define define="
                              cid python:item[0];
                              clabel python:item[1];
                              cval python:item[2];
                              cssvar python:item[3];
                            ">
                  <div class="col">
                    <label class="form-label small mb-1"
                           tal:content="clabel"
                           tal:attributes="
                             for string:th-${cid};
                           "
                    >Color</label>
                    <div style="display:flex; gap:.25rem; align-items:center;">
                      <input style="width:2.5rem; height:2rem; padding:.15rem; cursor:pointer;
                              border:1px solid #ced4da; border-radius:.25rem;"
                             type="color"
                             tal:attributes="
                               id string:th-${cid};
                               name string:${cid}_color;
                               value cval;
                               data-css-var cssvar;
                             "
                      />
                      <input class="form-control form-control-sm"
                             placeholder="#000000"
                             style="max-width:80px; font-family:monospace; font-size:.8rem;"
                             type="text"
                             tal:attributes="
                               id string:th-${cid}-text;
                               value cval;
                             "
                      />
                    </div>
                  </div>
                </tal:define>
              </tal:colors>
            </div>

            <p class="text-muted small mb-2">Plone UI colors</p>
            <div class="row row-cols-3 g-3 mb-4">
              <tal:pcolors tal:repeat="item view/plone_ui_colors">
                <tal:define define="
                              fname python:item[0];
                              cssvar python:item[1];
                              clabel python:item[2];
                              cval python:item[3];
                            ">
                  <div class="col">
                    <label class="form-label small mb-1"
                           tal:content="clabel"
                           tal:attributes="
                             for string:th-plone-${fname};
                           "
                    >Color</label>
                    <div style="display:flex; gap:.25rem; align-items:center;">
                      <input style="width:2.5rem; height:2rem; padding:.15rem; cursor:pointer;
                              border:1px solid #ced4da; border-radius:.25rem;"
                             type="color"
                             tal:attributes="
                               id string:th-plone-${fname};
                               name fname;
                               value cval;
                               data-css-var cssvar;
                             "
                      />
                      <input class="form-control form-control-sm"
                             placeholder="#000000"
                             style="max-width:80px; font-family:monospace; font-size:.8rem;"
                             type="text"
                             tal:attributes="
                               id string:th-plone-${fname}-text;
                               value cval;
                             "
                      />
                    </div>
                  </div>
                </tal:define>
              </tal:pcolors>
            </div>

            <p class="text-muted small mb-2">Workflow state colors</p>
            <div class="row row-cols-3 g-3 mb-2">
              <tal:scolors tal:repeat="item view/state_colors">
                <tal:define define="
                              fname python:item[0];
                              cssvar python:item[1];
                              clabel python:item[2];
                              cval python:item[3];
                            ">
                  <div class="col">
                    <label class="form-label small mb-1"
                           tal:content="clabel"
                           tal:attributes="
                             for string:th-state-${fname};
                           "
                    >Color</label>
                    <div style="display:flex; gap:.25rem; align-items:center;">
                      <input style="width:2.5rem; height:2rem; padding:.15rem; cursor:pointer;
                              border:1px solid #ced4da; border-radius:.25rem;"
                             type="color"
                             tal:attributes="
                               id string:th-state-${fname};
                               name fname;
                               value cval;
                               data-css-var cssvar;
                             "
                      />
                      <input class="form-control form-control-sm"
                             placeholder="#000000"
                             style="max-width:80px; font-family:monospace; font-size:.8rem;"
                             type="text"
                             tal:attributes="
                               id string:th-state-${fname}-text;
                               value cval;
                             "
                      />
                    </div>
                  </div>
                </tal:define>
              </tal:scolors>
            </div>

          </div>

          <!-- ── Typography ──────────────────────────────────────────── -->
          <div class="tab-pane fade"
               id="tab-typography"
               aria-labelledby="tab-typography-btn"
               role="tabpanel"
          >

            <!-- Google Font -->
            <div class="mb-4">
              <label class="form-label small mb-1"
                     for="th-google-font"
              >
            Google Font
                <span class="text-muted fw-normal"
                      style="font-size:.75rem;"
                >(--bs-body-font-family)</span>
              </label>
              <select class="form-select form-select-sm"
                      id="th-google-font"
                      name="google_font_family"
              >
                <tal:opts tal:repeat="term view/google_fonts_terms">
                  <tal:define define="
                                tval python:term[0];
                                ttitle python:term[1];
                              ">
                    <option tal:content="ttitle"
                            tal:attributes="
                              value tval;
                              selected python:tval == view.google_font_family;
                            "
                    >Font</option>
                  </tal:define>
                </tal:opts>
              </select>
              <div class="form-text">
            Configure your API key in
                <code>plone.palette.google_fonts_api_key</code>
            to unlock the full catalogue. Without a key a curated list of
                <tal:n tal:replace="python:len(view.google_fonts_terms) - 1" />
                 fonts is available.
              </div>
            </div>

            <!-- Body & Heading colors -->
            <p class="text-muted small mb-2">Body &amp; Headings</p>
            <div class="row row-cols-3 g-3 mb-4">
              <tal:typcols tal:repeat="item python:[
              ('body_color',    'Body text',     view.body_color,    '--bs-body-color'),
              ('body_bg',       'Body bg',       view.body_bg,       '--bs-body-bg'),
              ('heading_color', 'Heading color', view.heading_color, '--bs-heading-color'),
            ]">
                <tal:define define="
                              fname python:item[0];
                              clabel python:item[1];
                              cval python:item[2];
                              cssvar python:item[3];
                            ">
                  <div class="col">
                    <label class="form-label small mb-1"
                           tal:content="clabel"
                           tal:attributes="
                             for string:th-${fname};
                           "
                    >Color</label>
                    <div style="display:flex; gap:.25rem; align-items:center;">
                      <input style="width:2.5rem;height:2rem;padding:.1rem .15rem;cursor:pointer;border:1px solid #ced4da;border-radius:.25rem;flex-shrink:0;"
                             type="color"
                             tal:attributes="
                               id string:th-${fname};
                               name fname;
                               value cval;
                               data-css-var cssvar;
                             "
                      />
                      <input class="form-control form-control-sm"
                             style="max-width:90px;font-family:monospace;font-size:.8rem;"
                             type="text"
                             tal:attributes="
                               id string:th-${fname}-text;
                               value cval;
                             "
                      />
                    </div>
                  </div>
                </tal:define>
              </tal:typcols>
            </div>

            <!-- Font weight select -->
            <div class="mb-3">
              <label class="form-label small mb-1"
                     for="th-body-font-weight"
              >Font weight</label>
              <select class="form-select form-select-sm"
                      id="th-body-font-weight"
                      name="body_font_weight"
                      style="max-width:180px;"
                      data-css-var="--bs-body-font-weight"
              >
                <tal:opts tal:repeat="opt python:[('300','Light 300'),('400','Regular 400'),('500','Medium 500'),('600','Semi-bold 600'),('700','Bold 700')]">
                  <option tal:content="python:opt[1]"
                          tal:attributes="
                            value python:opt[0];
                            selected python:opt[0]==view.body_font_weight;
                          "
                  >weight</option>
                </tal:opts>
              </select>
            </div>

            <!-- Line height range -->
            <div class="mb-4">
              <label class="form-label small mb-1"
                     for="th-body-line-height"
              >
            Line height &mdash;
                <span id="th-body-line-height-display"
                      tal:content="view/body_line_height"
                >1.5</span>
                <span class="text-muted fw-normal"
                      style="font-size:.75rem;"
                >(--bs-body-line-height)</span>
              </label>
              <input class="form-range"
                     id="th-body-line-height"
                     max="2.5"
                     min="1"
                     name="body_line_height"
                     step="0.1"
                     type="range"
                     data-css-var="--bs-body-line-height"
                     tal:attributes="
                       value view/body_line_height;
                     "
              />
            </div>

            <!-- Font size -->
            <div class="mb-3">
              <label class="form-label small mb-1"
                     for="th-body-font-size"
              >
            Body font size &mdash;
                <span id="th-body-font-size-display"
                      tal:content="view/body_font_size"
                >1</span>
                 rem
                <span class="text-muted fw-normal"
                      style="font-size:.75rem;"
                >(--bs-body-font-size)</span>
              </label>
              <input class="form-range"
                     id="th-body-font-size"
                     max="1.5"
                     min="0.75"
                     name="body_font_size"
                     step="0.05"
                     type="range"
                     tal:attributes="
                       value view/body_font_size;
                     "
              />
            </div>

          </div>

          <!-- ── Borders ────────────────────────────────────────────── -->
          <div class="tab-pane fade"
               id="tab-borders"
               aria-labelledby="tab-borders-btn"
               role="tabpanel"
          >

            <p class="text-muted small mb-3">Border</p>
            <div class="row row-cols-2 g-3 mb-4">

              <!-- border-width: number input, px unit -->
              <div class="col">
                <label class="form-label small mb-1"
                       for="th-border-width"
                >
              Border width &mdash;
                  <span id="th-border-width-display"
                        tal:content="view/border_width"
                  >1</span>
                   px
                </label>
                <input class="form-control form-control-sm"
                       id="th-border-width"
                       max="10"
                       min="0"
                       name="border_width"
                       step="1"
                       type="number"
                       data-css-unit="px"
                       data-css-var="--bs-border-width"
                       tal:attributes="
                         value view/border_width;
                       "
                />
              </div>

              <!-- border-color: color picker -->
              <div class="col">
                <label class="form-label small mb-1"
                       for="th-border-color"
                >Border color</label>
                <div style="display:flex; gap:.25rem; align-items:center;">
                  <input id="th-border-color"
                         name="border_color"
                         style="width:2.5rem;height:2rem;padding:.1rem .15rem;cursor:pointer;border:1px solid #ced4da;border-radius:.25rem;flex-shrink:0;"
                         type="color"
                         data-css-var="--bs-border-color"
                         tal:attributes="
                           value view/border_color;
                         "
                  />
                  <input class="form-control form-control-sm"
                         id="th-border-color-text"
                         placeholder="#dee2e6"
                         style="max-width:90px;font-family:monospace;font-size:.8rem;"
                         type="text"
                         tal:attributes="
                           value view/border_color;
                         "
                  />
                </div>
              </div>

            </div>

            <p class="text-muted small mb-3">Rounded corners
              <span class="fw-normal">(rem)</span></p>
            <div class="row row-cols-2 g-3 mb-4">

              <tal:radii tal:repeat="item python:[
              ('border_radius',     'Base', view.border_radius,     '0', '2',   '0.025', '--bs-border-radius'),
              ('border_radius_sm',  'SM',   view.border_radius_sm,  '0', '1',   '0.025', '--bs-border-radius-sm'),
              ('border_radius_lg',  'LG',   view.border_radius_lg,  '0', '2',   '0.025', '--bs-border-radius-lg'),
              ('border_radius_xl',  'XL',   view.border_radius_xl,  '0', '3',   '0.05',  '--bs-border-radius-xl'),
              ('border_radius_xxl', 'XXL',  view.border_radius_xxl, '0', '4',   '0.1',   '--bs-border-radius-xxl'),
            ]">
                <tal:define define="
                              fname python:item[0];
                              rlabel python:item[1];
                              rval python:item[2];
                              rmin python:item[3];
                              rmax python:item[4];
                              rstep python:item[5];
                              rcssvar python:item[6];
                            ">
                  <div class="col">
                    <label class="form-label small mb-1"
                           tal:attributes="
                             for string:th-${fname};
                           "
                    >
                      <tal:replace replace="rlabel" />
                       &mdash;
                      <span tal:content="rval"
                            tal:attributes="
                              id string:th-${fname}-display;
                            "
                      >0</span>
                       rem
                    </label>
                    <input class="form-range"
                           type="range"
                           tal:attributes="
                             id string:th-${fname};
                             name fname;
                             min rmin;
                             max rmax;
                             step rstep;
                             value rval;
                             data-css-var rcssvar;
                             data-css-unit string:rem;
                           "
                    />
                  </div>
                </tal:define>
              </tal:radii>

            </div>

            <p class="text-muted small mb-3">Box shadows
              <span class="fw-normal">(CSS value or
                <code>none</code>)</span></p>
            <div class="row g-3 mb-2">
              <tal:shadows tal:repeat="item python:[
              ('box_shadow',    'Default', view.box_shadow),
              ('box_shadow_sm', 'Small',   view.box_shadow_sm),
              ('box_shadow_lg', 'Large',   view.box_shadow_lg),
            ]">
                <tal:define define="
                              fname python:item[0];
                              slabel python:item[1];
                              sval python:item[2];
                              scssvar python:'--bs-' + fname.replace('_','-');
                            ">
                  <div class="col-12">
                    <label class="form-label small mb-1"
                           tal:content="slabel"
                           tal:attributes="
                             for string:th-${fname};
                           "
                    >Shadow</label>
                    <input class="form-control form-control-sm"
                           style="font-family:monospace;font-size:.75rem;"
                           type="text"
                           tal:attributes="
                             id string:th-${fname};
                             name fname;
                             value sval;
                             data-css-var scssvar;
                           "
                    />
                  </div>
                </tal:define>
              </tal:shadows>
            </div>

          </div>

          <!-- ── Properties ──────────────────────────────────────────── -->
          <div class="tab-pane fade"
               id="tab-properties"
               aria-labelledby="tab-properties-btn"
               role="tabpanel"
          >

            <!-- Hidden sentinel: ensures enabled_properties key is always POSTed
             even when every checkbox is unchecked. -->
            <input name="enabled_properties"
                   type="hidden"
                   value=""
            />

            <div class="pat-checklist"
                 data-pat-checklist="select: .js-select-all; deselect: .js-deselect-all; toggle: .js-toggle-all"
            >

              <div class="d-flex align-items-center gap-2 mb-3">
                <label class="d-flex align-items-center gap-1 mb-0 text-muted small">
                  <input class="js-toggle-all form-check-input mt-0"
                         type="checkbox"
                  />
              Toggle all
                </label>
                <button class="btn btn-sm btn-outline-secondary js-select-all"
                        type="button"
                >Enable all</button>
                <button class="btn btn-sm btn-outline-secondary js-deselect-all"
                        type="button"
                >Disable all</button>
              </div>

              <fieldset class="border-0 p-0 m-0">
                <tal:props tal:repeat="prop view/bootstrap_properties">
                  <tal:define define="
                                pname python:prop[0];
                                plabel python:prop[1];
                                pdefault python:prop[2];
                              ">
                    <div class="form-check mb-2">
                      <input class="form-check-input"
                             name="enabled_properties"
                             type="checkbox"
                             tal:attributes="
                               id string:prop-${pname};
                               value pname;
                               checked python:pname in view.enabled_properties;
                             "
                      />
                      <label class="form-check-label"
                             tal:attributes="
                               for string:prop-${pname};
                             "
                      >
                        <span tal:replace="plabel">label</span>
                        <code class="text-muted ms-1"
                              style="font-size:.7rem;"
                              tal:content="python:'$enable-' + pname.replace('_','-').replace('enable-','')"
                        >
                        </code>
                        <tal:default condition="python:not pdefault">
                          <span class="badge bg-secondary ms-1"
                                style="font-size:.65rem;"
                          >off by default</span>
                        </tal:default>
                      </label>
                    </div>
                  </tal:define>
                </tal:props>
              </fieldset>

            </div>
          </div>

          <!-- ── Navbar & Footer ────────────────────────────────────── -->
          <div class="tab-pane fade"
               id="tab-navbar-footer"
               aria-labelledby="tab-navbar-footer-btn"
               role="tabpanel"
          >

            <p class="text-muted small mb-2">Navbar
              <span class="fw-normal">(<code>.navbar-barceloneta</code>
                /
                <code>.navbar-bootstrap6</code>)</span></p>
            <div class="row row-cols-2 g-3 mb-4">
              <div class="col">
                <label class="form-label small mb-1"
                       for="th-navbar-bg"
                >Background</label>
                <div style="display:flex; gap:.25rem; align-items:center;">
                  <input id="th-navbar-bg"
                         name="navbar_bg"
                         style="width:2.5rem;height:2rem;padding:.1rem .15rem;cursor:pointer;border:1px solid #ced4da;border-radius:.25rem;flex-shrink:0;"
                         type="color"
                         data-css-prop="--bs-navbar-background"
                         data-css-selector=".navbar-barceloneta"
                         tal:attributes="
                           value view/navbar_bg;
                         "
                  />
                  <input class="form-control form-control-sm"
                         id="th-navbar-bg-text"
                         style="max-width:90px;font-family:monospace;font-size:.8rem;"
                         type="text"
                         tal:attributes="
                           value view/navbar_bg;
                         "
                  />
                </div>
              </div>
            </div>

            <p class="text-muted small mb-2">Footer
              <span class="fw-normal">(<code>#portal-footer-wrapper</code>)</span></p>
            <div class="row row-cols-2 g-3 mb-2">
              <div class="col">
                <label class="form-label small mb-1"
                       for="th-footer-bg"
                >Background</label>
                <div style="display:flex; gap:.25rem; align-items:center;">
                  <input id="th-footer-bg"
                         name="footer_bg"
                         style="width:2.5rem;height:2rem;padding:.1rem .15rem;cursor:pointer;border:1px solid #ced4da;border-radius:.25rem;flex-shrink:0;"
                         type="color"
                         data-css-prop="background-color"
                         data-css-selector="#portal-footer-wrapper"
                         tal:attributes="
                           value view/footer_bg;
                         "
                  />
                  <input class="form-control form-control-sm"
                         id="th-footer-bg-text"
                         style="max-width:90px;font-family:monospace;font-size:.8rem;"
                         type="text"
                         tal:attributes="
                           value view/footer_bg;
                         "
                  />
                </div>
              </div>
              <div class="col">
                <label class="form-label small mb-1"
                       for="th-footer-color"
                >Text color</label>
                <div style="display:flex; gap:.25rem; align-items:center;">
                  <input id="th-footer-color"
                         name="footer_color"
                         style="width:2.5rem;height:2rem;padding:.1rem .15rem;cursor:pointer;border:1px solid #ced4da;border-radius:.25rem;flex-shrink:0;"
                         type="color"
                         data-css-prop="color"
                         data-css-selector="#portal-footer-wrapper"
                         tal:attributes="
                           value view/footer_color;
                         "
                  />
                  <input class="form-control form-control-sm"
                         id="th-footer-color-text"
                         style="max-width:90px;font-family:monospace;font-size:.8rem;"
                         type="text"
                         tal:attributes="
                           value view/footer_color;
                         "
                  />
                </div>
              </div>
            </div>

          </div>

          <!-- ── Custom CSS ───────────────────────────────────────────── -->
          <div class="tab-pane fade"
               id="tab-css"
               aria-labelledby="tab-css-btn"
               role="tabpanel"
          >
            <div class="mb-3">
              <label class="form-label small mb-1"
                     for="palette-custom-css"
              >Custom CSS</label>
              <textarea class="pat-code-editor"
                        id="palette-custom-css"
                        name="custom_css"
                        placeholder=":root {&#10;  /* additional overrides */&#10;}"
                        rows="400"
                        data-pat-code-editor="language: css;"
                        tal:content="view/custom_css"
              ></textarea>
            </div>

            <!-- Generated CSS — read-only preview -->
            <div class="mb-2 d-none">
              <label class="form-label small mb-1"
                     for="palette-generated-css"
              >
            Generated CSS
                <span class="text-muted fw-normal"
                      style="font-size:.75rem;"
                >(written to theming registry)</span>
              </label>
              <textarea class="form-control"
                        id="palette-generated-css"
                        readonly="readonly"
                        rows="8"
                        style="font-family:monospace; font-size:.75rem; background:#f8f9fa; resize:vertical;"
                        tal:content="view/generated_css"
              ></textarea>
            </div>
          </div>

        </div><!-- /.tab-content -->

        <!-- Reset: customizer.js confirms, POSTs form.button.reset to
             @@palette-save and reloads so the inputs repopulate. -->
        <div class="d-flex justify-content-end border-top pt-3 mt-3">
          <button class="btn btn-outline-danger btn-sm"
                  id="palette-reset-btn"
                  name="form.button.reset"
                  type="button"
                  value="reset"
                  i18n:translate="button_reset_theme"
          >Reset to defaults</button>
        </div>

      </form>

    </div><!-- /#palette-customizer-content -->

  </metal:form>

</tal:macros>
