<tal:toolbar xmlns="http://www.w3.org/1999/xhtml"
             xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             xmlns:metal="http://xml.zope.org/namespaces/metal"
             xmlns:tal="http://xml.zope.org/namespaces/tal"
             tal:define="
               icons python:context.restrictedTraverse('@@iconresolver');
             "
             i18n:domain="plone.palette"
>

  <!-- ════════════════════════════════════════════════════════════════════
       Toolbar entry: "Theming".  Rendered by the plone.toolbar viewlet
       manager, whose template wraps its viewlets in
       <ul class="nav flex-column plone-toolbar-main">, so this must be an
       <li> styled like the native Contents/Edit/Actions items.
       ════════════════════════════════════════════════════════════════════ -->
  <li class="nav-item"
      id="contentview-palette"
  >
    <a class="nav-link"
       aria-controls="palette-customizer-offcanvas"
       href="#palette-customizer-offcanvas"
       role="button"
       data-bs-toggle="offcanvas"
    >
      <tal:icon tal:replace="structure python:icons.tag('palette', tag_class='')" />
      <span class="toolbar-label"
            i18n:translate="label_theming"
      >Theming</span>
    </a>
  </li>

  <!-- The panel the entry opens.  Wrapped in a hidden <li> so the markup stays
       valid inside the toolbar <ul>; the offcanvas is position:fixed, so its
       place in the DOM is cosmetic. -->
  <li class="palette-panels list-unstyled">

    <div class="offcanvas offcanvas-end"
         id="palette-customizer-offcanvas"
         aria-labelledby="palette-customizer-offcanvas-title"
         style="width: 30rem;"
         tabindex="-1"
         data-bs-backdrop="false"
         data-bs-scroll="true"
    >
      <div class="offcanvas-header border-bottom">
        <h4 class="offcanvas-title"
            id="palette-customizer-offcanvas-title"
            i18n:translate="heading_customize_theme"
        >Customize theme</h4>
        <button class="btn-close"
                aria-label="Close"
                type="button"
                data-bs-dismiss="offcanvas"
                i18n:attributes="aria-label"
        ></button>
      </div>
      <div class="offcanvas-body">
        <metal:form use-macro="view/form_template/macros/palette-form" />
      </div>
    </div>

  </li>

</tal:toolbar>
