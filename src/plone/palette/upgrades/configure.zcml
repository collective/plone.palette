<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <!-- Example upgrade step
  <genericsetup:upgradeSteps
      profile="plone.palette:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Update registry value"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>
  -->

  <genericsetup:upgradeSteps
      profile="plone.palette:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Register the Theming toolbar entry"
        import_steps="viewlets"
        run_deps="false"
        />
    <genericsetup:upgradeStep
        title="Remove the obsolete palette_customizer site action"
        description="The customizer is now reached from the toolbar."
        handler=".remove_customizer_action"
        />
  </genericsetup:upgradeSteps>

  <!-- -*- extra stuff goes here -*- -->

</configure>
