<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <include package="plone.patternslib" />

  <!-- Optional: plone.palette[bootstrap6] -->
  <include
      package="plonetheme.bootstrap6"
      zcml:condition="installed plonetheme.bootstrap6"
      />

</configure>
